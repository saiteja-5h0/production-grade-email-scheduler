PORT=4000
CORS_ORIGIN=http://localhost:5173

DATABASE_URL="postgresql://postgres:your-postgres-password@localhost:5432/reachinbox"

REDIS_HOST=localhost
REDIS_PORT=6379
# Production: use the full connection URL supplied by your hosted Redis provider.
REDIS_URL=

ELASTICSEARCH_URL="http://localhost:9200"

WORKER_CONCURRENCY=5
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200

ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_SECURE=false
ETHEREAL_USER=
ETHEREAL_PASSWORD=
EMAIL_FROM="ReachInbox Demo <no-reply@reachinbox.local>"
# Choose `brevo` for Brevo HTTPS delivery or `ethereal` for local SMTP previews.
EMAIL_PROVIDER=ethereal
# Brevo sender must be verified in the Brevo dashboard.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="Email Scheduler"
BREVO_API_KEY=

FRONTEND_URL=http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
